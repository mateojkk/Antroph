# MemWal (Walrus Memory)
# The Python backend no longer writes to MemWal; only frontend env vars are required.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Frontend MemWal (each wallet owns its own MemWalAccount; users pay gas to create it and authorize a delegate key)
VITE_MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
VITE_MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
VITE_MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f

# Supabase (backend uses the service key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq (LLM). GROQ_MODEL overrides the default openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# football-data.org v4 (fixtures, live scores, match resolution)
FOOTBALL_DATA_API_KEY=

# Supabase (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_GOOGLE_CLIENT_ID=

# Sui network: mainnet | testnet | devnet (defaults to testnet)
VITE_SUI_NETWORK=mainnet

# Tatum Sui RPC (https://dashboard.tatum.io -> API key, pick the Sui mainnet RPC endpoint URL)
# The backend proxies whitelisted Sui JSON-RPC reads through Tatum and verifies
# that Walrus Memory writes actually landed onchain.
TATUM_API_KEY=
SUI_MAINNET_RPC=

# Antroph project agent (Walrus Memory). Create the agent in the Memory dashboard
# (memory.walrus.xyz), then paste the delegate key so the resolve cron can write
# scorecard memories to Walrus mainnet without a user being online.
# Its public key is the MEMWAL_AGENT_ID on the Total Recall submission form.
MEMWAL_AGENT_PRIVATE_KEY=
MEMWAL_AGENT_ACCOUNT_ID=
MEMWAL_AGENT_NAMESPACE=vela-colony

# Where the resolve cron finds /api/agentmem. Local dev default points at
# dev.mjs; in production set it to https://<your-deployment>/api/agentmem.
AGENTMEM_URL=http://localhost:3000/api/agentmem
AGENTMEM_MAX_WRITES=10
