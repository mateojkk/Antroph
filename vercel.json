{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "cd .. && npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py",
      "installCommand": "pip install -r api/requirements.txt",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "excludeFiles": "{frontend/**,node_modules/**,venv/**,scripts/**,supabase/**,.git/**,services/**,packages/**}"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "agentmem",
          "format": "url",
          "env": "AGENTMEM_URL"
        }
      ]
    },
    "api-stream": {
      "root": ".",
      "entrypoint": "api/agent_stream.py",
      "installCommand": "pip install -r api/requirements.txt",
      "functions": {
        "api/agent_stream.py": {
          "maxDuration": 60,
          "excludeFiles": "{frontend/**,node_modules/**,venv/**,scripts/**,supabase/**,.git/**,services/**,packages/**}"
        }
      }
    },
    "agentmem": {
      "root": "services/agentmem",
      "installCommand": "cd ../.. && npm install",
      "functions": {
        "api/index.mjs": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/agent_stream",
      "destination": {
        "service": "api-stream"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/resolve",
      "schedule": "0 0 * * *"
    }
  ]
}
